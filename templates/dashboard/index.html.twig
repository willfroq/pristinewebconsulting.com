{% extends 'base.html.twig' %}

{% block title %}Your client portal — Pristine Web Consulting{% endblock %}

{% block body %}
<section class="grid-paper min-h-[76vh] px-5 py-14">
    <div class="mx-auto max-w-6xl">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="text-sm font-bold uppercase tracking-[.18em] text-coral">Client portal</p>
                <h1 class="mt-2 font-display text-4xl font-bold sm:text-5xl">Welcome, {{ app.user.name|split(' ')|first }}.</h1>
                <p class="mt-3 max-w-2xl leading-7 text-ink/60">A private place for the context, decisions, and next steps behind your web consulting engagement.</p>
            </div>
            {% if proposals is not empty %}
                <span class="rounded-2xl bg-blue-100 px-6 py-3.5 text-center font-bold text-blue-950">Consultation awaiting approval</span>
            {% else %}
                <a href="{{ path('app_booking') }}" class="rounded-2xl bg-ink px-6 py-3.5 text-center font-bold text-white hover:bg-coral">Schedule a consultation →</a>
            {% endif %}
        </div>

        {% if proposals is not empty %}
            <section class="mt-10 rounded-3xl border border-blue-200 bg-blue-50 p-7 sm:p-9" aria-labelledby="pending-consultations-heading">
                <p class="text-xs font-bold uppercase tracking-[.16em] text-coral">Your consultation</p>
                <h2 id="pending-consultations-heading" class="mt-3 font-display text-2xl font-bold">Awaiting approval</h2>
                <p class="mt-3 text-sm leading-6 text-ink/60">Your proposed time is waiting for confirmation. We’ll show it here as scheduled once it has been accepted.</p>
                <div class="mt-6 space-y-3">
                    {% for proposal in proposals %}
                        <article class="rounded-2xl border border-blue-200 bg-white p-5">
                            <h3 class="font-display text-lg font-bold">{{ proposal.topic }}</h3>
                            <p class="mt-1 text-sm text-ink/65">{{ proposal.startsAt|date('l, d M Y · H:i T', 'Europe/Amsterdam') }}</p>
                        </article>
                    {% endfor %}
                </div>
                <a href="{{ path('app_consulting_payment') }}" class="mt-6 inline-block font-bold text-coral underline">Add another consultation</a>
            </section>
        {% endif %}

        {% if upcoming is not empty %}
            <section class="mt-10 rounded-3xl border border-lime/40 bg-lime/15 p-7 sm:p-9" aria-labelledby="scheduled-consultations-heading">
                <p class="text-xs font-bold uppercase tracking-[.16em] text-coral">Your schedule</p>
                <h2 id="scheduled-consultations-heading" class="mt-3 font-display text-2xl font-bold">Scheduled consultations</h2>
                <div class="mt-6 space-y-3">
                    {% for booking in upcoming %}
                        <article class="rounded-2xl border border-ink/10 bg-white p-5">
                            <h3 class="font-display text-lg font-bold">{{ booking.topic }}</h3>
                            <p class="mt-1 text-sm text-ink/65">{{ booking.startsAt|date('l, d M Y · H:i T', 'Europe/Amsterdam') }}</p>
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <div class="mt-10 grid gap-5 md:grid-cols-3">
            <article class="rounded-3xl border border-ink/15 bg-white p-7">
                <p class="text-xs font-bold uppercase tracking-[.16em] text-coral">Start here</p>
                <h2 class="mt-4 font-display text-2xl font-bold">Share the decision you need to make.</h2>
                <p class="mt-3 text-sm leading-6 text-ink/60">Tell me about the website, product, architecture, performance issue, or infrastructure concern you want to resolve.</p>
                <a href="{{ path('app_consulting_payment') }}" class="mt-6 inline-block font-bold text-coral underline">View consultation options</a>
            </article>
            <article class="rounded-3xl border border-ink/15 bg-white p-7">
                <p class="text-xs font-bold uppercase tracking-[.16em] text-coral">Your engagement</p>
                <h2 class="mt-4 font-display text-2xl font-bold">Clear scope. Practical outcomes.</h2>
                <p class="mt-3 text-sm leading-6 text-ink/60">Once we agree the right engagement, you’ll have a shared focus: the risks to reduce, opportunities to pursue, and actions to take next.</p>
            </article>
            <article class="rounded-3xl bg-ink p-7 text-white">
                <p class="text-xs font-bold uppercase tracking-[.16em] text-lime">How it works</p>
                <ol class="mt-5 space-y-4 text-sm leading-6 text-white/70">
                    <li><span class="mr-2 font-bold text-lime">01</span> Share the current situation.</li>
                    <li><span class="mr-2 font-bold text-lime">02</span> Choose the most useful engagement.</li>
                    <li><span class="mr-2 font-bold text-lime">03</span> Move forward with a clear plan.</li>
                </ol>
            </article>
        </div>

        <div class="mt-6 rounded-3xl border border-ink/15 bg-white p-7 sm:p-9">
            <p class="text-xs font-bold uppercase tracking-[.16em] text-coral">For active clients</p>
            <h2 class="mt-3 font-display text-2xl font-bold">Your next steps stay connected to the work.</h2>
            <p class="mt-3 max-w-3xl leading-7 text-ink/60">I’ll use your engagement context to keep recommendations focused and useful. If you need to add new information or arrange the next conversation, send a consultation request and I’ll follow up directly.</p>
        </div>
    </div>
</section>
{% endblock %}
