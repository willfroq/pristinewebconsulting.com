{% extends 'base.html.twig' %}

{% block title %}Check your email — Pristine Dev{% endblock %}

{% block body %}
<section class="grid-paper min-h-[72vh] px-5 py-20">
    <div class="soft-shadow mx-auto max-w-xl rounded-[2rem] border border-ink/15 bg-white p-8 text-center sm:p-12">
        <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-ink text-2xl text-lime">✉</span>
        <p class="mt-7 text-sm font-bold uppercase tracking-[.18em] text-coral">One more step</p>
        <h1 class="mt-3 font-display text-4xl font-bold">Check your email</h1>
        <p class="mx-auto mt-4 max-w-md leading-7 text-ink/60">We sent you a confirmation link. Open it within 24 hours to activate your account and access your client portal.</p>
        <p class="mt-7 text-sm text-ink/50">You can close this page after the email arrives.</p>
    </div>
</section>
{% endblock %}
