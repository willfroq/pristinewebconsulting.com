{% extends 'base.html.twig' %}

{% block title %}Payment confirmations — Pristine Dev{% endblock %}

{% block body %}
<section class="grid-paper min-h-[76vh] px-5 py-14">
    <div class="mx-auto max-w-5xl">
        <p class="text-sm font-bold uppercase tracking-[.18em] text-coral">Mentor workspace</p>
        <h1 class="mt-2 font-display text-4xl font-bold sm:text-5xl">Payment confirmations</h1>
        <p class="mt-3 text-ink/60">Check the transaction ID in your PayPal activity before approving. Approval grants one €89 lesson credit.</p>

        {% if payments is empty %}
            <div class="mt-10 rounded-[2rem] border border-dashed border-ink/20 bg-white p-10 text-center">
                <h2 class="font-display text-xl font-bold">No payments waiting</h2>
                <p class="mt-2 text-sm text-ink/55">Learner payment confirmations will appear here.</p>
            </div>
        {% else %}
            <div class="mt-10 space-y-4">
                {% for payment in payments %}
                    <article class="rounded-3xl border border-ink/15 bg-white p-6 sm:flex sm:items-center sm:justify-between sm:gap-8">
                        <div>
                            <p class="text-xs font-bold uppercase tracking-[.15em] text-coral">{{ payment.student.name }} · {{ payment.student.email }}</p>
                            <h2 class="mt-2 font-display text-xl font-bold">€{{ (payment.amountCents / 100)|number_format(2) }} {{ payment.currency }}</h2>
                            <p class="mt-2 text-sm text-ink/60">PayPal transaction ID: <b class="text-ink">{{ payment.paypalReference }}</b></p>
                            <p class="mt-1 text-xs text-ink/45">Submitted {{ payment.createdAt|date('d M Y · H:i') }}</p>
                        </div>
                        <div class="mt-5 flex gap-3 sm:mt-0">
                            <form method="post" action="{{ path('app_admin_payment_decline', {id: payment.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('decline_payment_' ~ payment.id) }}">
                                <button class="rounded-xl border border-ink/20 px-5 py-3 text-sm font-bold hover:bg-cream">Decline</button>
                            </form>
                            <form method="post" action="{{ path('app_admin_payment_approve', {id: payment.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('approve_payment_' ~ payment.id) }}">
                                <button class="rounded-xl bg-ink px-5 py-3 text-sm font-bold text-white hover:bg-coral">Approve payment</button>
                            </form>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
