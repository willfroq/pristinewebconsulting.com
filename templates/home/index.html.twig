{% extends 'base.html.twig' %}

{% block title %}Technical Advisor for Websites & Web Apps | Pristine Web Consulting{% endblock %}
{% block meta_description %}Independent technical advice for websites and web applications: performance audits, infrastructure reviews, architecture, AWS and hands-on troubleshooting.{% endblock %}
{% block canonical %}<link rel="canonical" href="https://pristinewebconsulting.com/">{% endblock %}
{% block structured_data %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"ProfessionalService","name":"Pristine Web Consulting","url":"https://pristinewebconsulting.com/","email":"pristine.web.dev@gmail.com","areaServed":"Netherlands and remote","priceRange":"€95–€140 per hour","description":"Independent technical consulting for websites, web applications, performance, architecture, and infrastructure."}</script>
{% endblock %}

{% block body %}
<section class="grid-paper overflow-hidden">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 lg:grid-cols-[1.08fr_.92fr] lg:px-8 lg:py-28">
        <div>
            <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[.16em]"><span class="size-2 rounded-full bg-coral"></span> Independent technical advisor · Hilversum & remote</div>
            <h1 class="max-w-3xl font-display text-5xl font-bold leading-[.98] tracking-[-.045em] sm:text-6xl lg:text-7xl">Make the next <span class="text-coral">technical decision</span> a confident one.</h1>
            <p class="mt-7 max-w-2xl text-lg leading-8 text-ink/70">I help teams and founders make websites and web applications faster, safer, easier to change—and less expensive to operate. Get an experienced second opinion before a small issue turns into a costly rebuild.</p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row"><a href="#contact" class="rounded-2xl bg-ink px-7 py-4 text-center font-bold text-white transition hover:-translate-y-1 hover:bg-coral">Book an introductory call <span aria-hidden="true">→</span></a><a href="#engagements" class="rounded-2xl border border-ink/20 bg-white px-7 py-4 text-center font-bold hover:border-ink">Explore engagements</a></div>
            <div class="mt-9 flex flex-wrap gap-x-7 gap-y-3 text-sm font-semibold text-ink/70"><span>✓ Plain-English advice</span><span>✓ Practical next steps</span><span>✓ No agency upsell</span></div>
        </div>
        <div class="relative lg:pl-8"><div class="soft-shadow rotate-2 rounded-[2rem] border border-ink/15 bg-ink p-4 text-white"><div class="flex items-center gap-2 border-b border-white/10 px-2 pb-4"><i class="size-3 rounded-full bg-coral"></i><i class="size-3 rounded-full bg-blue-300"></i><i class="size-3 rounded-full bg-mint"></i><span class="ml-3 font-mono text-xs text-white/40">technical-review.md</span></div><div class="space-y-6 px-2 py-8 font-mono text-sm leading-7"><p><span class="text-lime">✓</span> Find the actual bottleneck</p><p><span class="text-lime">✓</span> Prioritise risk and opportunity</p><p><span class="text-lime">✓</span> Turn findings into a plan</p><p class="text-white/40">// clear advice your team can use</p></div></div><div class="absolute -bottom-7 -left-2 -rotate-3 rounded-2xl bg-lime p-5 font-display font-bold text-ink shadow-xl">Less guesswork. Better decisions.<p class="mt-1 font-sans text-xs font-semibold opacity-60">For the work behind your digital product</p></div></div>
    </div>
</section>

<section id="services" class="mx-auto max-w-7xl px-5 py-24 lg:px-8"><div class="max-w-3xl"><p class="text-sm font-bold uppercase tracking-[.2em] text-coral">Where I can help</p><h2 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">A clear view of what is working, what is risky, and what comes next.</h2><p class="mt-5 leading-7 text-ink/65">I work across product, code, infrastructure, and delivery—so recommendations connect to the real business outcome, not just a tool preference.</p></div><div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{% set services = [['01','Website performance','Diagnose slow pages, Core Web Vitals, frontend weight, caching and database bottlenecks.'],['02','Architecture review','Pressure-test a new build, refactor, integrations, data model, or roadmap before commitment.'],['03','Infrastructure & AWS','Review hosting, PHP frameworks, cloud setup, deployment, observability, resilience and cost.'],['04','Technical advisor','An experienced technical sounding board for product choices, delivery risks, vendors and your team.']] %}{% for service in services %}<article class="rounded-3xl border border-ink/15 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg"><span class="font-mono text-sm font-bold text-coral">{{ service[0] }}</span><h3 class="mt-8 font-display text-xl font-bold">{{ service[1] }}</h3><p class="mt-3 text-sm leading-6 text-ink/65">{{ service[2] }}</p></article>{% endfor %}</div></section>

<section id="engagements" class="bg-ink py-24 text-white"><div class="mx-auto max-w-7xl px-5 lg:px-8"><div class="max-w-2xl"><p class="text-sm font-bold uppercase tracking-[.2em] text-lime">Focused engagements</p><h2 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">Start with the outcome you need.</h2><p class="mt-5 text-white/60">Every engagement ends with prioritised recommendations your team can act on.</p></div><div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{% set packages = [['Architecture review','2-hour focused review','€250','A structured second opinion on a key technical decision, with written next steps.'],['Performance audit','Website or web app audit','€750–1,500','Find the bottlenecks holding back speed, conversion, reliability and search visibility.'],['Infrastructure review','AWS / PHP frameworks','€1,000–2,500','Assess deployment, security, reliability, monitoring and cloud spend.'],['Code audit','PHP frameworks / CMS / DAM / PIM / dashboards','€1,500–3,000','An independent review of maintainability, integrations, data quality, dashboards, risk and the best improvement path.']] %}{% for package in packages %}<article class="rounded-3xl border border-white/15 p-6 hover:border-lime/70 hover:bg-white/5"><p class="text-xs font-bold uppercase tracking-[.16em] text-lime">{{ package[1] }}</p><h3 class="mt-5 font-display text-2xl font-bold">{{ package[0] }}</h3><p class="mt-5 font-display text-3xl font-bold">{{ package[2] }}</p><p class="mt-4 text-sm leading-6 text-white/60">{{ package[3] }}</p></article>{% endfor %}</div></div></section>

<section id="rates" class="mx-auto max-w-7xl px-5 py-24 lg:px-8"><div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><div><p class="text-sm font-bold uppercase tracking-[.2em] text-coral">Transparent rates</p><h2 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">Bring me in when clarity matters.</h2><p class="mt-5 leading-7 text-ink/65">Use a fixed package when the scope is clear, or an hourly engagement for ongoing advice and hands-on troubleshooting.</p><div class="mt-8 rounded-3xl bg-mint p-6"><p class="font-display text-xl font-bold">Fractional technical advisor</p><p class="mt-2 text-sm leading-6 text-ink/65">4–8 hours monthly at €100–120/hour for steady guidance without a full-time hire.</p></div></div><div class="grid gap-4 sm:grid-cols-3">{% set rates = [['€95/hour','Local SMEs & startups','An approachable rate for direct local clients and focused support.'],['€110/hour','Standard consulting','The usual rate for advisory, reviews and planned technical work.'],['€125–140/hour','Urgent / specialist','For troubleshooting, architecture, AWS migrations and performance optimisation.']] %}{% for rate in rates %}<article class="rounded-3xl border border-ink/15 bg-white p-7"><p class="font-display text-3xl font-bold text-coral">{{ rate[0] }}</p><h3 class="mt-6 font-display text-xl font-bold">{{ rate[1] }}</h3><p class="mt-3 text-sm leading-6 text-ink/65">{{ rate[2] }}</p></article>{% endfor %}</div></div></section>

<section class="border-y border-ink/10 bg-white py-24"><div class="mx-auto max-w-7xl px-5 lg:px-8"><div class="grid gap-6 md:grid-cols-3">{% set steps = [['01','Tell me what is happening','Share the product, current challenge and the decision or outcome you need.'],['02','Get the right engagement','I’ll suggest a focused call, an audit, or an ongoing advisory arrangement.'],['03','Move with a plan','You receive direct findings, priorities and practical next actions—not a vague report.']] %}{% for step in steps %}<article class="rounded-3xl border border-ink/15 bg-cream p-7"><span class="font-mono text-sm font-bold text-coral">{{ step[0] }}</span><h3 class="mt-6 font-display text-xl font-bold">{{ step[1] }}</h3><p class="mt-3 text-sm leading-6 text-ink/65">{{ step[2] }}</p></article>{% endfor %}</div></div></section>

<section id="contact" class="bg-coral py-20 text-white"><div class="mx-auto grid max-w-6xl gap-10 px-5 lg:grid-cols-[.85fr_1.15fr] lg:items-center lg:px-8"><div><p class="text-sm font-bold uppercase tracking-[.2em] text-white/65">Start with a conversation</p><h2 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">What would a better technical decision unlock?</h2><p class="mt-5 leading-7 text-white/75">Tell me a little about the website, web app, or technical challenge. I’ll reply with the most useful next step and an outline of the engagement.</p></div><div class="rounded-[2rem] bg-white p-8 text-ink sm:p-10"><h3 class="font-display text-2xl font-bold">Request a consultation</h3><p class="mt-3 leading-7 text-ink/65">Share the situation and the outcome you need. I’ll follow up to schedule a call.</p>{{ form_start(consultation_form, {attr: {class: 'mt-6 grid gap-4'}}) }}{{ form_row(consultation_form.name, {attr: {class: 'field'}}) }}{{ form_row(consultation_form.email, {attr: {class: 'field'}}) }}{{ form_row(consultation_form.website, {attr: {class: 'field'}}) }}{{ form_row(consultation_form.message, {attr: {class: 'field'}}) }}<div class="spam-trap" aria-hidden="true">{{ form_widget(consultation_form.company) }}</div>{{ form_widget(consultation_form.form_token) }}{{ form_widget(consultation_form.submit, {attr: {class: 'cursor-pointer rounded-2xl bg-ink px-6 py-4 font-bold text-white transition hover:bg-coral'}}) }}{{ form_end(consultation_form) }}<p class="mt-5 text-sm text-ink/50">Available for remote work and engagements in the Netherlands.</p></div></div></section>
{% endblock %}
