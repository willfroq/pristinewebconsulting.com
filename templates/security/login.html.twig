{% extends 'base.html.twig' %}

{% block title %}Log in — Pristine Dev{% endblock %}
{% block robots %}noindex, follow{% endblock %}
{% block canonical %}{% endblock %}

{% block body %}
<section class="grid-paper min-h-[72vh] px-5 py-20">
    <form method="post" class="soft-shadow mx-auto max-w-md rounded-[2rem] border border-ink/15 bg-white p-8 sm:p-10">
        <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-ink font-mono font-bold text-lime">&gt;_</span>
        <h1 class="mt-6 font-display text-3xl font-bold">Welcome back</h1>
        <p class="mt-2 text-sm text-ink/55">Your next breakthrough is closer than it feels.</p>
        {% if error %}
            <div class="mt-5 rounded-xl bg-red-50 p-4 text-sm text-red-800">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        <div class="mt-8">
            <label for="username" class="mb-2 block text-sm font-bold">Email address</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" class="field" autocomplete="email" required autofocus>
        </div>
        <div class="mt-5">
            <label for="password" class="mb-2 block text-sm font-bold">Password</label>
            <input type="password" name="_password" id="password" class="field" autocomplete="current-password" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="mt-7 w-full rounded-2xl bg-ink px-6 py-4 font-bold text-white hover:bg-coral">Log in to your dashboard</button>
        <p class="mt-6 text-center text-sm text-ink/55">New here? <a href="{{ path('app_register') }}" class="font-bold text-ink underline">Create your account</a></p>
    </form>
</section>
{% endblock %}
