<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Confirm your Pristine Dev account</title>
</head>
<body style="margin:0;background:#f7f4ed;font-family:Arial,sans-serif;color:#17212b;">
    <div style="max-width:560px;margin:0 auto;padding:40px 20px;">
        <div style="background:#ffffff;border:1px solid #d9d5cc;border-radius:24px;padding:36px;">
            <p style="margin:0 0 12px;color:#e85d3f;font-size:12px;font-weight:bold;text-transform:uppercase;letter-spacing:1.5px;">Pristine Dev</p>
            <h1 style="margin:0;font-size:30px;line-height:1.15;">Confirm your account</h1>
            <p style="margin:20px 0 0;line-height:1.7;color:#59636d;">Hi {{ user.name|split(' ')|first }}, confirm your email address to activate your learner account.</p>
            <p style="margin:28px 0;">
                <a href="{{ verification_url }}" style="display:inline-block;border-radius:14px;background:#17212b;padding:15px 22px;color:#ffffff;text-decoration:none;font-weight:bold;">Confirm my email →</a>
            </p>
            <p style="margin:0;color:#7b838a;font-size:13px;line-height:1.6;">This secure link expires in 24 hours. If you did not create this account, you can ignore this email.</p>
        </div>
    </div>
</body>
</html>
